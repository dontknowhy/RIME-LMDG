# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/

# ============================================================
# Gradle 构建产物与缓存
# 注意：不要忽略 gradle/ 目录本身，否则 gradle/wrapper/ 下的
# gradle-wrapper.jar 与 gradle-wrapper.properties 会被连带忽略，
# 导致新克隆无法用 ./gradlew 构建（父目录被忽略后 ! 反选无效）。
# ============================================================
.gradle/
build/
**/build/
gradletasknamecache
gradle-app.setting

# 保留 Gradle wrapper（必须提交）
!gradle-wrapper.jar
!gradle-wrapper.properties

# ============================================================
# Java 归档（*.jar 会匹配到 wrapper jar，需在其后单独反选）
# ============================================================
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.ear

# ============================================================
# Android / 签名 / 本机路径
# ============================================================
local.properties
*.apk
*.aab
*.ap_
*.dex
*.keystore
*.jks
captures/
.externalNativeBuild/
.cxx/

# ============================================================
# IDE
# ============================================================
.idea/
*.iml
*.ipr
*.iws
out/
.vscode/
*.code-workspace

# ============================================================
# 其它构建系统 / OS
# ============================================================
dist/
nbdist/
nbactions.xml
nb-configuration.xml
.DS_Store
Thumbs.db
